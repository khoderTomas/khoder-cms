# Proměnné služby cms-editor (EnvironmentFile), kopie do /home/cms/editor.env s právy 600.
# Popis všech proměnných: hlavička cms/editor.py. Návod: cms/INSTALACE.md.
CMS_URL=https://editor.mojedilna.cz
CMS_PORT=8765
CMS_USERS=/home/cms/data/users.json
CMS_SESSIONS=/home/cms/data/sessions.sqlite
CMS_JOURNAL=/home/cms/data/journal
CMS_WORK=/home/cms/data/work
CMS_SYNC_S=120
